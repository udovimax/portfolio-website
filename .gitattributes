# Store the large media assets in Git LFS instead of normal Git objects.
app/public/media/video/*.mp4 filter=lfs diff=lfs merge=lfs -text
app/public/media/audio/*.wav filter=lfs diff=lfs merge=lfs -text
app/public/media/audio/*.mp3 filter=lfs diff=lfs merge=lfs -text
app/public/media/max-instagram/loops/*.mp4 filter=lfs diff=lfs merge=lfs -text
app/public/media/max-instagram/gifs/*.gif filter=lfs diff=lfs merge=lfs -text
app/public/media/max-instagram/full-videos/*.mp4 filter=lfs diff=lfs merge=lfs -text
assets/source/more-photos/*.jpg filter=lfs diff=lfs merge=lfs -text
